@implements IDisposable
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation

<div class="top-row">
    <a class="navbar-brand" href="" aria-label="Plus One — главная">
        <img src="images/plus-one-logo-light.png" alt="" />
    </a>
    <button type="button"
            title="Открыть меню"
            aria-label="Открыть меню"
            aria-expanded="@(!collapseNavMenu)"
            class="navbar-toggler"
            @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable">
    <nav class="nav flex-column" aria-label="Основная навигация">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseNavMenu">
                <span class="nav-icon nav-icon--home" aria-hidden="true"></span>
                Главная
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="offers" @onclick="CloseNavMenu">
                <span class="nav-icon nav-icon--offers" aria-hidden="true"></span>
                Предложения
            </NavLink>
        </div>
        @if (CurrentUser.IsAdmin)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="admin/offers" @onclick="CloseNavMenu">
                    <span class="nav-icon nav-icon--admin" aria-hidden="true"></span>
                    Управление
                </NavLink>
            </div>
        }

        @if (CurrentUser.IsAuthorized)
        {
            <div class="nav-item nav-item--user">
                <span class="nav-user">@CurrentUser.User!.UserName</span>
            </div>
            <div class="nav-item">
                <button type="button" class="nav-link nav-link--button" @onclick="Logout">
                    Выйти
                </button>
            </div>
        }
        else
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="login" @onclick="CloseNavMenu">
                    Войти
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="registration" @onclick="CloseNavMenu">
                    Регистрация
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override void OnInitialized()
    {
        CurrentUser.Changed += StateHasChanged;
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void CloseNavMenu() => collapseNavMenu = true;

    private void Logout()
    {
        CurrentUser.Logout();
        CloseNavMenu();
        Navigation.NavigateTo("login");
    }

    public void Dispose()
    {
        CurrentUser.Changed -= StateHasChanged;
    }
}
